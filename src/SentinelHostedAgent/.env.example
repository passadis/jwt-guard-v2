FOUNDRY_PROJECT_ENDPOINT=https://<foundry-account>.services.ai.azure.com/api/projects/<foundry-project>
AZURE_AI_MODEL_DEPLOYMENT_NAME=gpt-4o
GATEWAY_RESOURCE_ID=/subscriptions/<subscription-id>/resourceGroups/<resource-group>/providers/Microsoft.Network/applicationGateways/<gateway-name>
LAW_WORKSPACE_GUID=<workspace-guid>
PROTECTED_HOST=sentinel-api.example.com
TENANT_ID=<tenant-guid>
API_CLIENT_ID=<api-application-guid>
APPLICATIONINSIGHTS_CONNECTION_STRING=<retrieve-securely-after-foundation-apply>

# Deliberately blank during independent deployment. It is enabled only after
# the fixed SentinelApp broker is reviewed and deployed.
BROKER_BASE_URI=

# Deliberately blank until the reviewed Foundry IQ toolbox exists.
TOOLBOX_NAME=
